    function normalizeCode(code) {
      return (code || "").toString().replace(/[-_\s()]/g, '').toLowerCase().trim();
    }

    function isSameItem(item1, item2) {
      let c1 = normalizeCode(item1.item); 
      let c2 = normalizeCode(item2.item);
      let d1 = normalizeCode(item1.desc);
      let d2 = normalizeCode(item2.desc);
      let s1 = normalizeCode(item1.cssd);
      let s2 = normalizeCode(item2.cssd);

      if (c1 && c2) {
          if (c1 === c2) return true;
          if (c1.length > 4 && c2.length > 4 && (c1.includes(c2) || c2.includes(c1))) return true; 
      }
      if (d1 && d2 && s1 && s2 && d1 === d2 && s1 === s2) return true;
      
      return false;
    }

    window.loadMasterItems = async function() {
        try {
            const querySnapshot = await getDocs(collection(db, "master_items"));
            masterItemsData = [];
            querySnapshot.forEach(doc => masterItemsData.push(doc.data()));
        } catch (e) { console.error("加載總表失敗", e); }
    }

    window.formatItemName = function(rawItem) {
        if(!rawItem) return "未知物品";
        let search = String(rawItem).toLowerCase().replace(/[-_\s()]/g, '');
        
        for(let m of masterItemsData) {
            let mCode = (m.code || "").toLowerCase().replace(/[-_\s()]/g, '');
            let mCat = (m.catNo || "").toLowerCase().replace(/[-_\s()]/g, '');
            
            if ((mCode && mCode === search) || (mCat && mCat === search) || 
                (mCode && search.includes(mCode)) || (mCat && search.includes(mCat))) {
                let parts = [];
                if(m.code) parts.push(m.code);
                if(m.desc) parts.push(m.desc);
                if(m.catNo) parts.push(m.catNo);
                return parts.join(', ');
            }
        }
        return rawItem; 
    }

