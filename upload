      document.body.appendChild(loadingDiv);

      try {
        const snapshot = await getDocs(collection(db, "master_items"));
        for (let docSnap of snapshot.docs) await deleteDoc(doc(db, "master_items", docSnap.id));

        for(let i = 1; i < rows.length; i++) { 
          let cells = rows[i].split('\t');
          if (cells.length >= 4) {
              let code = cells[0] ? cells[0].trim() : "";
