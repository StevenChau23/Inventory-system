    // --- 提取詳細資料的共用函數 ---
    window.extractItemDetails = function(t) {
        let mCode = t.haCode || "", mCat = t.catNo || "", mDesc = t.desc || "";
        
        if ((!mCat && !mDesc) && String(t.item).includes(" | ")) {
            let parts = String(t.item).split(" | ");
            mCat = parts[0] ? parts[0].trim() : "";
            mDesc = parts[1] ? parts[1].trim() : "";
            mCode = (parts.length > 2 && parts[2]) ? parts[2].trim() : "NA";
        }

        if (!mCat && !mDesc) {
            let search = String(t.item).toLowerCase().replace(/[-_\s()]/g, '');
            let foundMaster = masterItemsData.find(m => {
                let c = (m.code || "").toLowerCase().replace(/[-_\s()]/g, ''); 
                let cat = (m.catNo || "").toLowerCase().replace(/[-_\s()]/g, ''); 
                let d = (m.desc || "").toLowerCase().replace(/[-_\s()]/g, '');
                return (c && c === search) || (cat && cat === search) || (d && d === search);
            });
            if (foundMaster) { 
                mCode = foundMaster.code || mCode; 
                mCat = foundMaster.catNo || mCat; 
                mDesc = foundMaster.desc || mDesc; 
            }
        }

        if (!mCode || mCode.trim() === "" || mCode === "NA" || mCode.trim().toLowerCase() === mCat.trim().toLowerCase()) {
            mCode = "NA";
        }
        return { mCat, mDesc, mCode };
    }

