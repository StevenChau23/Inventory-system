    window.filterHistory = function(isExactMatch = false) {
      const searchText = document.getElementById('searchItem').value.trim();
      const startDate = document.getElementById('startDate').value; 
      const endDate = document.getElementById('endDate').value;
      
      let baseData = transactionsData.filter(t => (t.category || 'Consumable') === currentQueryCategory);
      
let runningBalData = [...baseData].sort((a, b) => {
          let d1 = new Date(a.date).getTime(); let d2 = new Date(b.date).getTime();
          if (d1 !== d2) return d1 - d2;
          
          let t1 = a.timestamp ? (a.timestamp.seconds ? a.timestamp.seconds * 1000 : new Date(a.timestamp).getTime()) : 0;
          let t2 = b.timestamp ? (b.timestamp.seconds ? b.timestamp.seconds * 1000 : new Date(b.timestamp).getTime()) : 0;
          if (t1 !== t2) return t1 - t2;
          
          if (a.type === "Opening Balance" && b.type !== "Opening Balance") return -1;
          if (b.type === "Opening Balance" && a.type !== "Opening Balance") return 1;
          return 0;
      });
let itemBalances = {};
      
runningBalData.forEach(t => {
      let k = getItemBalanceKey(t);
      if (!itemBalances[k]) itemBalances[k] = 0;
      let q = parseFloat(t.qty) || 0; let adj = parseFloat(t.sysAdjust) || 0; 
      if (t.type === "Opening Balance") { itemBalances[k] = q; } 
      else if (t.type === "In") { itemBalances[k] += (q + adj); } 
      else if (t.type === "Out") { itemBalances[k] -= q; itemBalances[k] += adj; }
      t.runningBalance = Math.round(itemBalances[k] * 1000) / 1000;
  });

if (searchText !== "") {
        let searchLower = searchText.toLowerCase();
        let searchIsExact = isExactMatch || searchText.includes("|");
        if (searchIsExact) {
            let searchParts = searchText.split("|").map(s => s.trim().toLowerCase());
            runningBalData = runningBalData.filter(t => {
                let { mCat, mDesc, mCode } = extractItemDetails(t);
                let fieldsToMatch = [ mCode.toLowerCase(), mCat.toLowerCase(), mDesc.toLowerCase(), String(t.item).toLowerCase() ];
                return searchParts.every(part => { if (!part) return true; return fieldsToMatch.some(f => f.includes(part)); });
            });
        } else {
            runningBalData = runningBalData.filter(t => {
                let { mCat, mDesc, mCode } = extractItemDetails(t);
                let fieldsToMatch = [ mCode.toLowerCase(), mCat.toLowerCase(), mDesc.toLowerCase(), String(t.item).toLowerCase() ];
                return fieldsToMatch.some(field => field.includes(searchLower));
            });
        }
      }

      let finalDisplayData = runningBalData;
      if (startDate) finalDisplayData = finalDisplayData.filter(t => t.date >= startDate);
      if (endDate) finalDisplayData = finalDisplayData.filter(t => t.date <= endDate);

      updateChart(finalDisplayData, searchText);

      let totalIn = 0; let totalOut = 0; let totalOpening = 0;
      finalDisplayData.forEach(t => {
          let q = parseFloat(t.qty) || 0;
          if (t.type === "Opening Balance") totalOpening += q;
          else if (t.type === "In") totalIn += q;
          else if (t.type === "Out") totalOut += q;
      });

      let currentBal = finalDisplayData.length > 0 ? finalDisplayData[finalDisplayData.length - 1].runningBalance : 0;
      
      finalDisplayData = finalDisplayData.reverse(); 
      window.currentQueryData = finalDisplayData; 

      let balanceHtml = "";
      if (searchText !== "") {
        let balanceColor = currentBal < 0 ? "#e74c3c" : "#27ae60";
        let dateText = startDate && endDate ? `${startDate} 至 ${endDate}` : startDate ? `${startDate} 至今` : endDate ? `截至 ${endDate}` : "所有紀錄時間";
        balanceHtml = `📦 物品 <strong>"${searchText}"</strong> 的統計：<br>
                       <div style="margin-top: 10px; padding: 10px; background: rgba(255,255,255,0.6); border-radius: 6px;">
                         📅 期間 (${dateText}) ➜ 期初結餘(Opening): <b>${totalOpening}</b> | 期間入庫(In): <b>${totalIn}</b> | 期間出庫(Out): <b>${totalOut}</b>
                       </div>
                       <span style="font-size: 1.2rem; margin-top:10px; display:inline-block;">期末系統結餘 (Latest Balance): <strong style="color:${balanceColor}; font-size: 1.6rem;">${currentBal}</strong></span>`;
      }

      document.getElementById('balanceDisplay').innerHTML = balanceHtml;
      renderHistoryTable(searchText === "" && startDate === "" && endDate === "" ? finalDisplayData.slice(0, 5) : finalDisplayData);
    }

