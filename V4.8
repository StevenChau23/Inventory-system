    window.toggleAllMaster = function(checkbox) {
        document.querySelectorAll('.master-checkbox').forEach(cb => cb.checked = checkbox.checked);
    };

    window.batchUpdateCategory = async function(newCategory) {
        let selected = Array.from(document.querySelectorAll('.master-checkbox:checked')).map(cb => ({
            id: cb.dataset.id, key: cb.dataset.key, isMaster: cb.dataset.ismaster === 'true',
            cat: cb.dataset.cat, desc: cb.dataset.desc, code: cb.dataset.code
        }));
        
        if (selected.length === 0) { alert("請先勾選要歸類的物品！"); return; }
        if (!confirm(`確定要將選中的 ${selected.length} 個物品歸類為 ${newCategory} 嗎？\n(這將會同步更新所有相關的歷史紀錄)`)) return;

        document.body.style.cursor = 'wait';
        try {
            for (let item of selected) {
                if (item.isMaster && item.id) {
                    await updateDoc(doc(db, "master_items", item.id), { category: newCategory });
                } else {
                    await addDoc(collection(db, "master_items"), { 
                        catNo: item.cat !== '-' ? item.cat : '', desc: item.desc !== '-' ? item.desc : '', 
                        code: item.code !== '-' ? item.code : 'NA', uom: '', category: newCategory
                    });
                }

                let matchingTxs = transactionsData.filter(t => {
                    let { mCat, mDesc, mCode } = extractItemDetails(t);
                    return mCat === item.cat && mDesc === item.desc && (mCode === item.code || (mCode === 'NA' && item.code === '-'));
                });
                
                for (let t of matchingTxs) {
                    if (t.category !== newCategory) await updateDoc(doc(db, "transactions", t.id), { category: newCategory });
                }
            }
            alert(`✅ 成功歸類 ${selected.length} 個物品為 ${newCategory}！`);
            await loadMasterItems(); await loadStockData(); renderMasterList();
        } catch(e) { console.error(e); alert("歸類失敗"); }
        document.body.style.cursor = 'default';
    };

