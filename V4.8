    window.renderExpiryTable = function() {
      const tbody = document.getElementById('expiryTbody'); tbody.innerHTML = "";
      let searchText = (document.getElementById('searchExpiry') ? document.getElementById('searchExpiry').value.trim().toLowerCase() : "");
      let expiryData = transactionsData.filter(t => t.expiryDate && t.expiryDate.trim() !== "");
      
      let displayData = [];
      expiryData.forEach(t => {
          let { mCat, mDesc, mCode } = extractItemDetails(t);
          let match = true;
          if(searchText !== "") {
              let fieldsToMatch = [ mCat.toLowerCase(), mDesc.toLowerCase(), mCode.toLowerCase(), String(t.item).toLowerCase() ];
              match = fieldsToMatch.some(f => f.includes(searchText));
          }
          if(match) displayData.push({ ...t, mCat, mDesc, mCode });
      });

      displayData.sort((a, b) => new Date(a.expiryDate) - new Date(b.expiryDate));

      if (displayData.length === 0) { tbody.innerHTML = "<tr><td colspan='9' style='text-align:center;'>尚未有任何含有過期日的紀錄</td></tr>"; return; }

      let today = new Date(); today.setHours(0,0,0,0);

      displayData.forEach(t => {
        let expDate = new Date(t.expiryDate); expDate.setHours(0,0,0,0);
        let diffDays = Math.ceil((expDate - today) / (1000 * 60 * 60 * 24));

        let dateStyle = "color:#27ae60; font-weight:bold;"; 
        let alarmText = "";
        let bgStyle = "";

        if (diffDays < 0) {
            dateStyle = "color:#c0392b; font-weight:bold;"; // Red
            alarmText = "<br><span style='font-size:0.8rem;'>已過期</span>";
            bgStyle = "background-color: #fadbd8;";
        } else if (diffDays <= 60) {
            dateStyle = "color:#c0392b; font-weight:bold;"; // Red
            alarmText = "<br><span style='font-size:0.8rem;'>🚨 2個月內</span>";
            bgStyle = "background-color: #fadbd8;";
        } else if (diffDays <= 90) {
            dateStyle = "color:#d35400; font-weight:bold;"; // Orange
            alarmText = "<br><span style='font-size:0.8rem;'>⚠️ 3個月內</span>";
            bgStyle = "background-color: #fcf3cf;";
        }

        let typeColor = t.type === "In" ? "#27ae60" : t.type === "Out" ? "#e74c3c" : "#8e44ad";
        
        let tr = document.createElement('tr');
        tr.innerHTML = `<td style="${dateStyle} ${bgStyle}">${t.expiryDate}${alarmText}</td>
                        <td><strong>${t.mCat || '-'}</strong></td><td title="資料庫原始數據: ${t.item}">${t.mDesc || '-'}</td>
                        <td>${t.mCode || '-'}</td><td>${t.lotNo || '-'}</td><td>${t.poNo || '-'}</td>
                        <td>${t.qty}</td><td style="color: ${typeColor}; font-weight: bold;">${t.type}</td><td style="color:#7f8c8d; font-size:0.9rem;">${t.date}</td>`;
        tbody.appendChild(tr);
      });
    }

