        loadStockData(); 
      } catch (error) { console.error(error); alert("寫入失敗"); submitBtn.disabled = false; submitBtn.innerText = "提交紀錄"; }
    });

function isDuplicateTx(date, itemObj, type) {
      // 移除對 qty 與 sysAdjust 的強制比對，只要該月份該物品已有 In/Out/Opening，即視為重覆 (解決結餘重覆問題)
      return transactionsData.some(t => 
        t.date === date && t.type === type && 
        (t.category || 'Consumable') === (itemObj.category || 'Consumable') && isSameItem(t, itemObj)
      );
    }

    // --- 管理員操作功能 ---
    window.handleMasterPaste = async function(e) {
      const clipboardData = e.clipboardData || window.clipboardData; const pastedData = clipboardData.getData('Text');
      if (!pastedData || !pastedData.includes('\t')) return; e.preventDefault();
      
      const rows = parseTSV(pastedData).filter(row => row.some(cell => cell.trim() !== ''));
      if(!confirm(`確定要匯入 ${rows.length - 1} 行資料作為「物品總表參照」嗎？\n(這將覆蓋舊有總表)`)) return;

      const loadingDiv = document.createElement('div');
      loadingDiv.style.cssText = "position:fixed; top:20px; right:20px; background:#333; color:#fff; padding:10px 20px; border-radius:5px; z-index:9999;";
      loadingDiv.innerText = "正在匯入並更新總表資料庫..."; document.body.appendChild(loadingDiv);

      try {
        const snapshot = await getDocs(collection(db, "master_items"));
        for (let docSnap of snapshot.docs) await deleteDoc(doc(db, "master_items", docSnap.id));

        for(let i = 1; i < rows.length; i++) { 
          let cells = rows[i];
          if (cells.length >= 4) {
              let code = cells[0] ? cells[0].trim() : ""; let desc = cells[1] ? cells[1].trim() : ""; let catNo = cells[3] ? cells[3].trim() : "";
              if(!code) code = "NA";
              if(code || desc || catNo) await addDoc(collection(db, "master_items"), { code, desc, catNo });
          }
        }
        document.body.removeChild(loadingDiv); alert(`🎉 總表匯入成功！`); await loadMasterItems();
        if(transactionsData.length > 0) filterHistory(); document.getElementById('masterPasteArea').value = '';
      } catch (err) { console.error(err); document.body.removeChild(loadingDiv); alert("匯入總表失敗"); }
    }

    window.deleteAllData = async function() {
        if(!confirm("⚠️ 警告：這將會刪除系統中「所有」的庫存紀錄！\n如需重新匯入全部 Excel 以對齊結餘，請確認執行。\n確定要繼續嗎？（此操作無法復原）")) return;
        if(prompt("請輸入 'DELETE' 以確認刪除所有數據：") !== 'DELETE') { alert("已取消刪除。"); return; }
        
        const loadingDiv = document.createElement('div');
        loadingDiv.style.cssText = "position:fixed; top:20px; right:20px; background:#e74c3c; color:#fff; padding:12px 24px; border-radius:6px; z-index:9999; font-weight:bold;";
        loadingDiv.innerText = "🗑️ 正在清空所有庫存資料，請稍候..."; document.body.appendChild(loadingDiv);

        try {
            const snapshot = await getDocs(collection(db, "transactions")); let count = 0;
            for (let docSnap of snapshot.docs) { await deleteDoc(doc(db, "transactions", docSnap.id)); count++; }
            document.body.removeChild(loadingDiv); alert(`✅ 已成功刪除 ${count} 筆紀錄！現在系統已清空，請重新匯入你的 Excel。`); loadStockData();
        } catch (e) { console.error(e); if (document.body.contains(loadingDiv)) document.body.removeChild(loadingDiv); alert("❌ 刪除失敗"); }
    }

