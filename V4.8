      };

      try {
        await addDoc(collection(db, "transactions"), data);
        submitBtn.innerText = "提交成功！"; submitBtn.style.backgroundColor = "#28a745";
        setTimeout(() => { submitBtn.innerText = "提交紀錄"; submitBtn.style.backgroundColor = ""; submitBtn.disabled = false; }, 2000);
        document.getElementById('stockForm').reset();
