    window.updateChart = function(filteredData, searchText = "") {
      const chartCanvas = document.getElementById('usageChart');
      if (!chartCanvas) return;
      
      let chartData = {};
      let detectedUom = "";

      filteredData.forEach(d => {
          if (!d.date) return;
          
          // 嘗試抓取 UOM 顯示
          if (searchText && !detectedUom && d.uom && d.uom !== "-" && d.uom !== "NA") {
              detectedUom = d.uom;
          }

          let key = "";
          if (window.chartGroupBy === 'FY') {
              let dateObj = new Date(d.date);
              let y = dateObj.getFullYear();
              let m = dateObj.getMonth() + 1; // 1-12
              key = m >= 4 ? `${y}-${(y+1).toString().slice(-2)}` : `${y-1}-${y.toString().slice(-2)}`;
          } else {
              // 月度顯示 (YYYY-MM)
              let dateParts = d.date.split('-');
              key = `${dateParts[0]}-${dateParts[1]}`; 
          }
          
          if(!chartData[key]) chartData[key] = { in: 0, out: 0 };
          let q = parseFloat(d.qty) || 0;
          if (d.type === 'In') chartData[key].in += q;
          if (d.type === 'Out' || (d.remarks || "").includes("過期")) chartData[key].out += q;
      });

      // 後備機制：如果過濾數據沒有抓到 UOM，到 Master 清單找找
      if (searchText && !detectedUom) {
          let searchLower = searchText.toLowerCase().trim();
          for (let m of masterItemsData) {
              if ( ((m.code || "").toLowerCase().includes(searchLower) || 
                    (m.catNo || "").toLowerCase().includes(searchLower) || 
                    (m.desc || "").toLowerCase().includes(searchLower)) && 
                    m.uom && m.uom !== "-" && m.uom !== "NA" ) {
                  detectedUom = m.uom;
                  break;
              }
          }
      }

      let labels = Object.keys(chartData).sort();
      let inValues = labels.map(k => chartData[k].in);
      let outValues = labels.map(k => chartData[k].out);

      let datasets = [];
      if (window.chartMode === 'In' || window.chartMode === 'Both') {
          datasets.push({ label: "總入庫量 (In)", data: inValues, backgroundColor: 'rgba(39, 174, 96, 0.8)', borderRadius: 4 });
      }
      if (window.chartMode === 'Out' || window.chartMode === 'Both') {
          datasets.push({ label: "總出庫量 (Out)", data: outValues, backgroundColor: 'rgba(231, 76, 60, 0.8)', borderRadius: 4 });
      }

      let uomText = detectedUom ? ` (UOM: ${detectedUom})` : "";
      let timeLabel = window.chartGroupBy === 'FY' ? '年度' : '月度';
      let titleText = searchText ? `物品 "${searchText}" 的${timeLabel} In/Out 統計${uomText}` : `全部分類${timeLabel} In/Out 統計`;
      
      renderChart(labels, datasets, titleText);
    };

    function renderChart(labels, datasets, titleText) {
      const chartCanvas = document.getElementById('usageChart');
      if (!chartCanvas) return;
      const ctx = chartCanvas.getContext('2d');
