    window.formatItemName = function(rawItem) {
        if(!rawItem) return "未知物品";
        let search = String(rawItem).toLowerCase().replace(/[-_\s()]/g, '');
        for(let m of masterItemsData) {
            let mCode = (m.code || "").toLowerCase().replace(/[-_\s()]/g, '');
            let mCat = (m.catNo || "").toLowerCase().replace(/[-_\s()]/g, '');
            let mDesc = (m.desc || "").toLowerCase().replace(/[-_\s()]/g, '');
            if ((mCode && mCode === search) || (mCat && mCat === search) || (mDesc && mDesc === search)) {
                let parts = []; if(m.catNo) parts.push(m.catNo); if(m.desc) parts.push(m.desc); if(m.code && m.code !== "NA") parts.push(m.code);
                return parts.join(' | ');
            }
        }
        return rawItem; 
    }

    window.showSuggestions = function(val) {
        let box = document.getElementById("suggestionBox");
        if (!val || val.trim() === "") { box.style.display = "none"; return; }
        let search = val.toLowerCase().trim();
        let uniqueMatches = new Map();

        masterItemsData.forEach(m => {
            let code = (m.code || "").toLowerCase(); let cat = (m.catNo || "").toLowerCase(); let desc = (m.desc || "").toLowerCase();
            if (code.includes(search) || cat.includes(search) || desc.includes(search)) {
                let label = [m.catNo, m.desc, m.code !== "NA" ? m.code : ""].filter(Boolean).join(" | ").replace(/\r?\n/g, ' ');
                uniqueMatches.set(label, label);
            }
        });

        transactionsData.forEach(t => {
            if ((t.category || 'Consumable') !== currentQueryCategory) return;
            let tItem = String(t.item || "").toLowerCase();
            let mCode = (t.haCode || "").toLowerCase(); let mCat = (t.catNo || "").toLowerCase(); let mDesc = (t.desc || "").toLowerCase();
            if (tItem.includes(search) || mCode.includes(search) || mCat.includes(search) || mDesc.includes(search)) {
                 let label = [t.catNo, t.desc, (t.haCode && t.haCode !== "NA") ? t.haCode : ""].filter(Boolean).join(" | ").replace(/\r?\n/g, ' ');
                 if(!label) label = String(t.item).replace(/\r?\n/g, ' ');
                 uniqueMatches.set(label, label);
            }
        });

        let matches = Array.from(uniqueMatches.values());
        if (matches.length === 0) { box.style.display = "none"; return; }
        
        let html = "";
        matches.forEach(label => {
            html += `<div style="padding: 8px 12px; cursor: pointer; border-bottom: 1px solid #eee; font-size:0.9rem;" 
                          onmouseover="this.style.background='#f0f0f0'" onmouseout="this.style.background='#fff'"
