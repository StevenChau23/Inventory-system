    window.cleanDuplicates = async function() {
        if(!confirm("⚠️ 系統將掃描並刪除重覆數據。\n確認執行？")) return;
        document.body.style.cursor = 'wait';
        let toDelete = []; let kept = [];
        let sortedData = [...transactionsData].sort((a, b) => new Date(a.date) - new Date(b.date));

        for (let t of sortedData) {
            let isDup = kept.some(k => k.date === t.date && k.type === t.type && k.qty === t.qty && (k.sysAdjust || 0) === (t.sysAdjust || 0) && (k.category || 'Consumable') === (t.category || 'Consumable') && isSameItem(k, t) );
            if (isDup) toDelete.push(t.id); else kept.push(t);
        }
        
        if(toDelete.length === 0) { alert("✅ 系統中沒有重覆數據。"); document.body.style.cursor = 'default'; return; }
        if(confirm(`👀 發現 ${toDelete.length} 筆重覆數據！點擊確定刪除。`)) {
            for (let id of toDelete) await deleteDoc(doc(db, "transactions", id));
            alert(`🎉 成功清除 ${toDelete.length} 筆重覆數據！`); loadStockData();
        }
        document.body.style.cursor = 'default';
    }
window.fixSystemBalances = async function() {
        if(!confirm("⚠️ 確定要執行「修正結餘運算」嗎？\n這將會清除系統中異常的自動調整數 (sysAdjust)，強制以真實的 In / Out 數量重新計算結餘！")) return;
