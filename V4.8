      if (!uDate || !uItem || isNaN(uQty)) { alert("請填寫完整資訊！"); return; }
      
      let p_catNo = "", p_desc = "", p_haCode = "";
      if (uItem.includes(" | ")) {
          let parts = uItem.split(" | ");
          p_catNo = parts[0] ? parts[0].trim() : "";
          p_desc = parts[1] ? parts[1].trim() : "";
          p_haCode = (parts.length > 2 && parts[2]) ? parts[2].trim() : "NA";
      }

      try { 
        await updateDoc(doc(db, "transactions", id), { 
            category: uCategory, date: uDate, item: uItem, 
            catNo: p_catNo || record.catNo, desc: p_desc || record.desc, haCode: p_haCode || record.haCode, 
            type: uType, qty: uQty, sysAdjust: parseFloat(document.getElementById(`edit-sysAdjust-${id}`).value) || 0, 
            remarks: document.getElementById(`edit-remarks-${id}`).value, packSize: document.getElementById(`edit-packSize-${id}`).value.trim(), 
            lotNo: document.getElementById(`edit-lot-${id}`).value.trim(), poNo: document.getElementById(`edit-po-${id}`).value.trim(), 
            expiryDate: document.getElementById(`edit-exp-${id}`).value 
        }); 
