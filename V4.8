            document.body.appendChild(modal);
            document.getElementById('btnSame').onclick = () => { document.body.removeChild(modal); resolve(true); };
            document.getElementById('btnNew').onclick = () => { document.body.removeChild(modal); resolve(false); };
        });
    };
    function isSameItem(item1, item2) {
      let c1 = normalizeCode(item1.item); let c2 = normalizeCode(item2.item);
      let d1 = normalizeCode(item1.desc); let d2 = normalizeCode(item2.desc);
      let cat1 = normalizeCode(item1.catNo); let cat2 = normalizeCode(item2.catNo);
      let ha1 = normalizeCode(item1.haCode); let ha2 = normalizeCode(item2.haCode);

      if (c1 && c2 && c1 === c2) return true;
      if (ha1 && ha2 && ha1 !== 'na' && ha2 !== 'na' && ha1 === ha2) return true;
      let combo1 = cat1 + "|" + d1; let combo2 = cat2 + "|" + d2;
      if (combo1 === combo2 && combo1 !== "|") return true;
      return false;
    }
window.getItemBalanceKey = function(t) {
        let { mCat, mDesc, mCode } = extractItemDetails(t);
        let c = normalizeCode(mCode);
        if (c && c !== "na") return "code:" + c;
        let cat = normalizeCode(mCat);
        let d = normalizeCode(mDesc);
        if (cat || d) return "catdesc:" + cat + "|" + d;
        return "raw:" + normalizeCode(t.item || "");
    };
