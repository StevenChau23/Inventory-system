        let allItemsMap = new Map();
        
        masterItemsData.forEach(m => {
            let key = `${(m.catNo || '').trim()}|${(m.code || '').trim()}|${(m.desc || '').trim()}`;
            allItemsMap.set(key, { id: m.id, cat: m.catNo || '-', desc: m.desc || '-', code: m.code !== 'NA' ? m.code : '-', uom: m.uom || '-', category: m.category || 'Master', isMaster: true });
        });

        transactionsData.forEach(t => {
            let { mCat, mDesc, mCode } = extractItemDetails(t);
            let key = `${mCat.trim()}|${mCode.trim()}|${mDesc.trim()}`;
