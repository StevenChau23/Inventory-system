    window.updateCurrentBalanceDisplay = function(itemName) {
        const display = document.getElementById('currentItemBalance');
        if(!itemName || itemName.trim() === "") { display.innerHTML = ""; return; }
        
        let bal = 0;
        let category = document.getElementById('addCategory').value;
        let searchRaw = itemName.toLowerCase().replace(/[-_\s()|]/g, '');

        let sortedData = [...transactionsData]
            .filter(t => (t.category || 'Consumable') === category)
            .sort((a, b) => new Date(a.date) - new Date(b.date));

let targetKey = getItemBalanceKey({ item: itemName, category: category });

        sortedData.forEach(t => {
            let tKey = getItemBalanceKey(t);
            if(tKey === targetKey) {
                let q = parseFloat(t.qty) || 0;
                let adj = parseFloat(t.sysAdjust) || 0;
                if(t.type === 'Opening Balance') { bal = q; }
                else if(t.type === 'In') { bal += (q + adj); }
                else if(t.type === 'Out') { bal -= q; bal += adj; }
            }
        });
        
        let currentBal = bal;
        let expectedBal = bal;
        let inputQty = parseFloat(document.getElementById('qty').value) || 0;
        let inputType = document.getElementById('type').value;

        if(inputQty > 0) {
            if(inputType === 'In' || inputType === 'Opening Balance') expectedBal += inputQty;
            else if(inputType === 'Out') expectedBal -= inputQty;
        }

        let currentStr = `💡 當前系統結餘估算: <strong style="font-size:1.1em; color:#2c3e50;">${Math.round(currentBal * 1000) / 1000}</strong>`;
        let expectedStr = "";

        if (inputQty > 0) {
            let exColor = expectedBal < 0 ? "#e74c3c" : "#27ae60";
            expectedStr = `<span style="margin-left:15px; border-left:2px solid #ccc; padding-left:15px;">👉 預計提交後更新為: <strong style="font-size:1.3em; color:${exColor};">${Math.round(expectedBal * 1000) / 1000}</strong></span>`;
        }
        
        display.innerHTML = currentStr + expectedStr;
    }

